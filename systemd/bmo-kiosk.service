[Unit]
Description=BMO Chromium Kiosk
After=bmo-xorg.service bmo-x-init.service bmo-ui.service
Requires=bmo-xorg.service bmo-x-init.service
Wants=bmo-ui.service

[Service]
Type=simple
User=r36s
Group=r36s
Environment=HOME=/home/r36s
ExecStart=/usr/local/bin/bmo-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
